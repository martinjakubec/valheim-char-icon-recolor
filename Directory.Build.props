<Project>
  <!-- Machine-specific paths. Adjust these if Valheim or the r2modman profile live elsewhere. -->
  <PropertyGroup>
    <ValheimDir>C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimManaged>$(ValheimDir)\valheim_Data\Managed</ValheimManaged>
    <R2Profile>$(AppData)\r2modmanPlus-local\Valheim\profiles\dev</R2Profile>
    <PluginDir>$(R2Profile)\BepInEx\plugins</PluginDir>
  </PropertyGroup>
</Project>
